<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_description</name>
  <version>0.1.0</version>
  <description>
    URDF, meshes and RViz config for the 4-DOF cylindrical arm.
    Description-only package: no source code, just installable share/ assets.
    Other packages reference these via package://arm_description/...
  </description>

  <maintainer email="amr.alqaffas@gmail.com">Amr Al-Qaffas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Tools that consumers of this URDF need at runtime -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
