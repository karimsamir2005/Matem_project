<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  urdf_pkg.urdf.xacro
  ============================================================================
  Original source : SolidWorks sw2urdf exporter
  Hand-cleaned for: ROS 2 Jazzy + MoveIt 2 + IK control with PS4 joystick

  WHAT CHANGED FROM THE ORIGINAL sw2urdf OUTPUT:
    1. Converted to Xacro so we can use macros and parameters.
    2. Added a 'world' link and a fixed joint anchoring base_link to it.
       MoveIt requires a fixed reference frame for planning. Without a
       world link, RViz/MoveIt will complain that the planning frame is
       not fixed relative to anything.
    3. Replaced the all-zero joint limits with sensible defaults
       (-PI to +PI for now). YOU SHOULD TIGHTEN THESE LATER once you
       know the real limits of your motors and what won't cause the
       arm to crash into itself.
    4. Renamed 'Jonit_EE' (typo) to 'joint_ee'.
    5. Lowercased joint and link names for consistency
       (your code will reference these as strings — typos hurt later).
    6. Inertia/mass values are LEFT AS-IS because we are doing
       kinematic-only IK. They do not affect MoveIt's IK calculations.
       If you ever simulate dynamics in Gazebo, fix them then.

  THE KINEMATIC CHAIN:
    world -[fixed]-> base_link
                       |
                     joint1 (revolute, axis Z = vertical) — base yaw
                       |
                     link_1
                       |
                     joint2 (revolute, axis Z in rotated frame = horizontal)
                       |
                     link_2  : 13 cm long
                       |
                     joint3 (revolute, axis -Z = horizontal, opposite sense)
                       |
                     link_3  : 18 cm long
                       |
                     joint4 (revolute, axis Z = horizontal)
                       |
                     link_4
                       |
                     joint_ee (fixed)
                       |
                       ee   (Tool Center Point, where MoveIt aims)

  Maximum reach: ~50.5 cm from base center.
  ============================================================================
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="urdf_pkg">

  <!-- ===========================================================
       PARAMETERS — change these in one place, applied everywhere.
       This is the whole point of using Xacro instead of plain URDF.
       =========================================================== -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Joint limits: ±180° for now, tighten later when we know the real values.
       'effort' and 'velocity' are required tags but the values don't affect
       kinematic IK. Setting them to non-zero placeholders so MoveIt is happy. -->
  <xacro:property name="joint_lower" value="${-PI}"/>
  <xacro:property name="joint_upper" value="${PI}"/>
  <xacro:property name="joint_effort" value="10.0"/>     <!-- N·m placeholder -->
  <xacro:property name="joint_velocity" value="2.0"/>    <!-- rad/s placeholder -->

  <!-- ===========================================================
       MATERIALS — pure visualization, not used by IK.
       =========================================================== -->
  <material name="link_color">
    <color rgba="0.792 0.820 0.933 1.0"/>
  </material>
  <material name="ee_color">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- ===========================================================
       WORLD LINK — the fixed reference frame.
       Without this, MoveIt's planning frame floats. Required.
       =========================================================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===========================================================
       BASE LINK — the immobile mounting platform.
       =========================================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.067620331934757 -0.00120530262409933 0.0108754850356396" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="1.08125906153827E-05" ixz="-0.00732913860008387"
        iyy="0.0316859741654106"  iyz="-5.01161636737393E-05"
        izz="0.0273822814846579"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/base_link.STL"/>
      </geometry>
      <material name="link_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ===========================================================
       JOINT 1 — base yaw (rotates everything around vertical axis).
       =========================================================== -->
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="${joint_lower}"
      upper="${joint_upper}"
      effort="${joint_effort}"
      velocity="${joint_velocity}"/>
  </joint>

  <link name="link_1">
    <inertial>
      <origin xyz="0.067620331934757 -0.00120530262409933 0.0108754850356396" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="1.08125906153827E-05" ixz="-0.00732913860008387"
        iyy="0.0316859741654106"  iyz="-5.01161636737393E-05"
        izz="0.0273822814846579"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link_1.STL"/>
      </geometry>
      <material name="link_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link_1.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ===========================================================
       JOINT 2 — shoulder pitch.
       The rpy="1.5708 0 0" rotates the frame 90° around X so that
       the joint's local Z becomes horizontal. After this rotation,
       a positive joint angle pitches the arm forward.
       =========================================================== -->
  <joint name="joint2" type="revolute">
    <origin xyz="-0.0181173331571768 0 0.0856148078402347" rpy="1.5707963267949 0 0"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="${joint_lower}"
      upper="${joint_upper}"
      effort="${joint_effort}"
      velocity="${joint_velocity}"/>
  </joint>

  <link name="link_2">
    <inertial>
      <origin xyz="0.0857376650919338 -0.0747393228045951 0.00120530262409906" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="-0.00732913860008387" ixz="-1.08125906152948E-05"
        iyy="0.0273822814846579"  iyz="5.01161636737656E-05"
        izz="0.0316859741654106"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link2.STL"/>
      </geometry>
      <material name="link_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link2.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ===========================================================
       JOINT 3 — elbow pitch. Note axis="0 0 -1": negative because
       the elbow rotates in the OPPOSITE sense from the shoulder.
       (sw2urdf detected this from your SolidWorks mate direction.)
       =========================================================== -->
  <joint name="joint3" type="revolute">
    <origin xyz="0.13 0 0" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 0 -1"/>
    <limit
      lower="${joint_lower}"
      upper="${joint_upper}"
      effort="${joint_effort}"
      velocity="${joint_velocity}"/>
  </joint>

  <link name="link_3">
    <inertial>
      <origin xyz="-0.0442623349080663 -0.0747393228045951 0.00120530262409914" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="-0.00732913860008387" ixz="-1.08125906152948E-05"
        iyy="0.0273822814846579"  iyz="5.01161636737656E-05"
        izz="0.0316859741654106"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link3.STL"/>
      </geometry>
      <material name="link_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link3.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ===========================================================
       JOINT 4 — wrist pitch.
       =========================================================== -->
  <joint name="joint4" type="revolute">
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="${joint_lower}"
      upper="${joint_upper}"
      effort="${joint_effort}"
      velocity="${joint_velocity}"/>
  </joint>

  <link name="link_4">
    <inertial>
      <origin xyz="-0.224262334908066 -0.0747393228045961 0.00120530262410021" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="-0.00732913860008387" ixz="-1.08125906152948E-05"
        iyy="0.0273822814846579"  iyz="5.01161636737656E-05"
        izz="0.0316859741654106"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link4.STL"/>
      </geometry>
      <material name="link_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Link4.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ===========================================================
       JOINT_EE — fixed transform from wrist to TCP (Tool Center Point).
       This is where MoveIt will aim when given an XYZ target.
       The "Jonit_EE" typo from sw2urdf is corrected here.
       =========================================================== -->
  <joint name="joint_ee" type="fixed">
    <origin xyz="0.195 0 0" rpy="0 0 0"/>
    <parent link="link_4"/>
    <child link="ee"/>
  </joint>

  <link name="ee">
    <inertial>
      <origin xyz="-0.419262334908066 -0.0747393228045968 0.00120530262410087" rpy="0 0 0"/>
      <mass value="1.33047360553679"/>
      <inertia
        ixx="0.00715767355668369" ixy="-0.00732913860008387" ixz="-1.08125906152972E-05"
        iyy="0.0273822814846579"  iyz="5.01161636737649E-05"
        izz="0.0316859741654106"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/EE.STL"/>
      </geometry>
      <material name="ee_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/EE.STL"/>
      </geometry>
    </collision>
  </link>

</robot>
